# Package defaults
STORAGE_DISK=local
STORAGE_ROUTES_ENABLED=false
STORAGE_ACTIVITIES_ENABLED=false
STORAGE_ACTIVITY_MIGRATIONS=false
STORAGE_USERS_TABLE=
STORAGE_WORKSPACES_TABLE=

# Upload and read limits in bytes
STORAGE_UPLOAD_MAX_SIZE=52428800
STORAGE_UPLOAD_MAX_CHUNK_SIZE=10485760
STORAGE_READ_MAX_SIZE=52428800

# Google Drive OAuth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# OneDrive OAuth
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=
ONEDRIVE_TENANT_ID=common

# Optional Amazon S3 / S3-compatible credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BUCKET=
AWS_S3_PUBLIC_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional private Amazon S3 / S3-compatible credentials
PRIVATE_AWS_ACCESS_KEY_ID=
PRIVATE_AWS_SECRET_ACCESS_KEY=
PRIVATE_AWS_DEFAULT_REGION=us-east-1
PRIVATE_AWS_BUCKET=
PRIVATE_AWS_S3_BUCKET=
PRIVATE_AWS_S3_PUBLIC_BUCKET=
PRIVATE_AWS_S3_PUBLIC_URL=
PRIVATE_AWS_ENDPOINT=
PRIVATE_AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional FTP disk
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=
FTP_PORT=21
FTP_ROOT=
FTP_PASSIVE=true
FTP_SSL=false
FTP_TIMEOUT=30

# Optional Azure Blob credentials
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=

# Optional Google Cloud Storage settings
GCS_BUCKET=
GCS_KEY_FILE=
GCS_PATH_PREFIX=

# Optional Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Package defaults
STORAGE_DISK=local
STORAGE_ROUTES_ENABLED=false
# Protected package routes must keep auth middleware unless this explicit escape hatch is enabled.
STORAGE_ALLOW_UNAUTHENTICATED_PROTECTED_ROUTES=false
STORAGE_HTTP_RATE_LIMITS_ENABLED=true
STORAGE_PUBLIC_RATE_LIMIT=30
STORAGE_AUTHENTICATED_RATE_LIMIT=240
STORAGE_ACTIVITIES_ENABLED=false
STORAGE_ACTIVITY_MIGRATIONS=false
STORAGE_USERS_TABLE=
STORAGE_WORKSPACES_TABLE=
STORAGE_UPLOAD_MAX_SIZE=52428800
STORAGE_UPLOAD_MAX_CHUNK_SIZE=10485760
STORAGE_READ_MAX_SIZE=52428800

# Google Drive OAuth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# OneDrive OAuth
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=
ONEDRIVE_TENANT_ID=common

# Dropbox OAuth
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=

# Optional Amazon S3 / S3-compatible credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=

# Optional Azure Blob credentials
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=

# Optional Google Cloud Storage settings
GCS_BUCKET=
GCS_KEY_FILE=
GCS_PATH_PREFIX=

# Optional Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media processing / trust pipeline
STORAGE_PROCESSING_ENABLED=true
STORAGE_PROCESSING_AUTO_DISPATCH=true
STORAGE_PROCESSING_INLINE=false
STORAGE_PROCESSING_CONNECTION=
STORAGE_PROCESSING_QUEUE=media-processing
STORAGE_PROCESSING_TRIES=3
STORAGE_PROCESSING_TIMEOUT=60
STORAGE_PROCESSING_DISPATCH_LEASE=300
STORAGE_PROCESSING_STALE_AFTER=15

# Content-signature inspection is enabled independently of malware scanning.
STORAGE_CONTENT_INSPECTION_ENABLED=true
STORAGE_CONTENT_INSPECTION_PREFIX_BYTES=65536

# Virus scanning is opt-in. Install/run ClamAV before enabling.
STORAGE_VIRUS_SCANNING_ENABLED=false
STORAGE_CLAMAV_BINARY=clamscan
STORAGE_SCAN_TIMEOUT=30
STORAGE_SCAN_MAX_SIZE=52428800
STORAGE_QUARANTINE_UNTIL_CLEAN=true
STORAGE_QUARANTINE_REQUIRE_PRIVATE=true
STORAGE_ALLOW_ON_SCAN_FAILURE=false

# Image decompression-bomb defenses
STORAGE_IMAGE_MAX_WIDTH=12000
STORAGE_IMAGE_MAX_HEIGHT=12000
STORAGE_IMAGE_MAX_PIXELS=40000000

# Direct S3-compatible uploads (optional)
STORAGE_DIRECT_UPLOADS_ENABLED=false
STORAGE_DIRECT_UPLOADS_FALLBACK=true
STORAGE_DIRECT_UPLOADS_REQUIRE_SHA256=true
STORAGE_DIRECT_UPLOADS_MULTIPART_THRESHOLD=33554432
STORAGE_DIRECT_UPLOADS_PART_SIZE=8388608
STORAGE_DIRECT_UPLOADS_INITIAL_PARTS=5
STORAGE_DIRECT_UPLOADS_MAX_SIGNED_PARTS=100
STORAGE_DIRECT_UPLOADS_URL_TTL=900
STORAGE_DIRECT_UPLOADS_SESSION_TTL=60
STORAGE_DIRECT_UPLOADS_STREAM_CHECKSUM=true
STORAGE_DIRECT_UPLOADS_MAX_STREAM_CHECKSUM=1073741824

# Observability / operational health
STORAGE_OBSERVABILITY_ENABLED=true
STORAGE_OBSERVABILITY_LOG=true
STORAGE_OBSERVABILITY_EVENTS=true
STORAGE_OBSERVABILITY_LOG_CHANNEL=
STORAGE_HEALTH_MAX_WORKSPACES=1000
STORAGE_HEALTH_QUOTA_DRIFT_TOLERANCE=0
STORAGE_HEALTH_ORPHAN_WARNING=1
STORAGE_HEALTH_ORPHAN_CRITICAL=100
STORAGE_HEALTH_STUCK_UPLOAD_MINUTES=30
STORAGE_HEALTH_STUCK_DIRECT_UPLOAD_MINUTES=30
STORAGE_HEALTH_PROCESSING_BACKLOG_MINUTES=30

# Large-workspace query controls
STORAGE_QUERY_MAX_PER_PAGE=200
# Optional benchmark fixture sizes
STORAGE_BENCHMARK_FOLDERS=500
STORAGE_BENCHMARK_MEDIA=5000
STORAGE_BENCHMARK_GRANTS=500
STORAGE_BENCHMARK_MAX_QUERIES=40

# Derivatives
STORAGE_DERIVATIVE_MAX_SOURCE_BYTES=20971520
STORAGE_DERIVATIVE_THUMBNAIL_ENABLED=true
STORAGE_DERIVATIVE_THUMBNAIL_WIDTH=320
STORAGE_DERIVATIVE_THUMBNAIL_HEIGHT=240
STORAGE_DERIVATIVE_THUMBNAIL_QUALITY=80
STORAGE_DERIVATIVE_THUMBNAIL_FORMATS=jpeg
STORAGE_DERIVATIVE_THUMBNAIL_PRIMARY=jpeg
STORAGE_DERIVATIVE_PREVIEW_ENABLED=false
STORAGE_DERIVATIVE_PREVIEW_WIDTH=1600
STORAGE_DERIVATIVE_PREVIEW_HEIGHT=1600
STORAGE_DERIVATIVE_PREVIEW_QUALITY=82
STORAGE_DERIVATIVE_PREVIEW_FORMATS=webp,jpeg
STORAGE_DERIVATIVE_PREVIEW_PRIMARY=webp

# Object-storage compensation cleanup
STORAGE_ORPHAN_MAX_ATTEMPTS=10

# Retention / bulk
STORAGE_RETENTION_ENABLED=false
STORAGE_RETENTION_TRASH_DAYS=30
STORAGE_RETENTION_TEMP_GRACE_HOURS=0
STORAGE_RETENTION_UPLOAD_SESSION_DAYS=7
STORAGE_RETENTION_DIRECT_UPLOAD_DAYS=7
STORAGE_RETENTION_BATCH_SIZE=250
STORAGE_BULK_MAX_ITEMS=100
STORAGE_BULK_ALLOW_PERMANENT_DELETE=false
